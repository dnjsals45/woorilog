# 홈 배포 환경 변수 예시. 실제 값은 .env.home 에 두고 커밋하지 않습니다.
#
#   cp .env.home.example .env.home
#   그리고 아래 "직접 생성" 표시가 붙은 값을 채웁니다.
#
# 자세한 절차는 docs/engineering/home-deployment.md 를 보세요.

# 브라우저가 실제로 여는 주소입니다. 카카오 redirect URI 와 CORS 가 여기서 파생됩니다.
# 프로토콜과 포트까지 정확히 맞춰야 합니다 — http 와 https 는 카카오 입장에서 다른 URI 입니다.
PUBLIC_ORIGIN=http://woorilog.local

# nginx 를 내보낼 호스트 포트. 80 이 이미 쓰이는 기기면 8080 등으로 바꾸고
# PUBLIC_ORIGIN 에도 같은 포트를 적습니다. 카카오 redirect URI 도 같이 바꿔 등록해야 합니다.
WEB_PORT=80

# 아래 둘은 127.0.0.1 에만 묶입니다 — 호스트에서 DB·백엔드를 직접 들여다볼 때만 씁니다.
# 와이파이로는 열리지 않습니다. 앞자리 1 은 개발용(3306 / 8080)과 구분하려는 것입니다.
MYSQL_HOST_PORT=13306
BACKEND_HOST_PORT=18080

# 기본 profile 로 둡니다. local 로 두면 개발자 로그인이 켜집니다.
SPRING_PROFILES_ACTIVE=

MYSQL_DATABASE=woorilog
MYSQL_USER=woorilog
# 직접 생성: openssl rand -base64 24
MYSQL_PASSWORD=
# 직접 생성: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=

# 카카오 Developers 에서 발급합니다. redirect URI 는 PUBLIC_ORIGIN 에서 파생되므로 여기 적지 않습니다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 직접 생성: openssl rand -base64 48
# 개발용 기본값을 그대로 쓰면 안 됩니다. 이 값을 아는 사람은 아무 사용자로도 로그인할 수 있습니다.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=1800
JWT_REFRESH_TOKEN_TTL_SECONDS=1209600

# http 로 서비스하는 동안은 false 입니다. https 로 바꾸면 true 로 올립니다.
REFRESH_COOKIE_SECURE=false

# 프로덕션 빌드에서는 프론트에 버튼 자체가 없습니다. 백엔드 쪽도 닫아 둡니다.
DEV_LOGIN_ENABLED=false

# MySQL 덤프를 받을 호스트 폴더. 컨테이너 안 /backups 로 연결됩니다.
BACKUP_DIR=./backups
